<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive database and credentials from cleartext cloud backups -->
        <exclude domain="database" path="gbr_paints_production_db" />
        <exclude domain="database" path="gbr_paints_production_db-shm" />
        <exclude domain="database" path="gbr_paints_production_db-wal" />
        <exclude domain="sharedpref" path="gbr_sync_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow direct device-to-device transfer for convenience, but exclude credentials -->
        <exclude domain="sharedpref" path="gbr_sync_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
